# Public site configuration
# The Supabase URL and publishable key are required for every Vercel Preview
# and Production deployment. Builds fail early when either is missing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CONTACT_EMAIL=info@dailyredsea.com
# Canonical public origin (no trailing slash), e.g. https://dailyredsea.com.
# Used for links in emails/PDFs and for Twilio webhook signature checks.
NEXT_PUBLIC_SITE_URL=
# Customer-facing WhatsApp number, digits only in international format
# (e.g. 201154516040). Invalid or empty values fall back to the default.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Environment and admin access
# "test" or "live"; shown as the admin environment badge. Falls back to VERCEL_ENV.
APP_ENV=
# Owner/admin account email; defaults to info@dailyredsea.com.
ADMIN_EMAIL=
# Bearer secret Vercel Cron sends to /api/cron/admin-automation.
CRON_SECRET=

# Booking confirmation PDF
# Optional override. Leave unset to use the approved Daily Red Sea policy in
# lib/pdf-policy.ts. Separate override paragraphs with \n\n.
CANCELLATION_POLICY_TEXT=
# HMAC secret for guest ticket/QR links. Defaults to deriving from the
# Supabase service role key; set it to decouple the two.
TICKET_SIGNING_SECRET=

# Email and WhatsApp delivery (server-only)
# Customer email is always sent as Daily Red Sea <info@dailyredsea.com>.
# Use the Google app password belonging to info@dailyredsea.com, or a Resend
# account where dailyredsea.com has been verified.
GMAIL_SMTP_APP_PASSWORD=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# Approved WhatsApp Content template SID for supplier dispatch messages
TWILIO_WHATSAPP_SUPPLIER_CONTENT_SID=

# Optional analytics (see docs/analytics-setup.md)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_EMAIL_CONVERSION_LABEL=

# Server-only Google Ads reporting API (admin dashboard)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Recommended for Vercel when service-account key creation is disabled
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Alternative authentication method
GOOGLE_ADS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_ADS_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_ADS_API_VERSION=v25
GOOGLE_ANALYTICS_PROPERTY_ID=

# Server-only Google Search Console monitoring (SEO checks)
# Service-account credentials fall back to GOOGLE_ADS_SERVICE_ACCOUNT_* when unset.
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY=

# Required for privileged admin APIs, automation and managed live content.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Supabase Management API personal access token, used by the daily automation
# to verify managed backups. Project ref defaults to the one in the Supabase URL.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# Server-only live Google Business reviews (Places API New)
GOOGLE_PLACES_API_KEY=
# Defaults to the current Daily Red Sea Google place when omitted
GOOGLE_PLACE_ID=ChIJXZ9eh4x-YCURk7atPmlNA5c

# Referral program ("Give 5% — Get 5%")
# Signs short-lived redemption tokens issued after a customer verifies their
# email/phone by OTP on /referrals, proving ownership before their earned
# referral rewards can be redeemed at checkout. Generate a long random value
# (e.g. `openssl rand -hex 32`) and keep it secret; without it, redemption of
# earned rewards is disabled but new-customer 5% referral discounts still work.
REFERRAL_TOKEN_SECRET=
