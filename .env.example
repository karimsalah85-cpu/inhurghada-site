# Public site configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_CONTACT_EMAIL=info@dailyredsea.com

# Email and WhatsApp delivery (server-only)
# Customer email is always sent as Daily Red Sea <info@dailyredsea.com>.
# Use the Google app password belonging to info@dailyredsea.com, or a Resend
# account where dailyredsea.com has been verified.
GMAIL_SMTP_APP_PASSWORD=
RESEND_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# Optional analytics (see docs/analytics-setup.md)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CONVERSIONS_API_ACCESS_TOKEN=
META_GRAPH_API_VERSION=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
NEXT_PUBLIC_GOOGLE_ADS_BOOKING_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_WHATSAPP_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_PHONE_CONVERSION_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_EMAIL_CONVERSION_LABEL=

# Server-only Google Ads reporting API (admin dashboard)
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_ADS_SERVICE_ACCOUNT_PRIVATE_KEY=
